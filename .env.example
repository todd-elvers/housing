# Generated by `housing introspect --format env-example`. Copy to .env and fill in.
# The no-auth sources run on an empty .env; keys below only unlock extra sources/features.

# Max listings to pull per run (optional)
# APARTMENTS_MAX_ITEMS=

# Apify API token — https://console.apify.com/account/integrations (required)
# APIFY_TOKEN=

# Location to scrape (optional)
# HOMEHARVEST_LOCATION=

# Only listings from the last N days (optional)
# HOMEHARVEST_PAST_DAYS=

# SQLite database path (optional)
# HOUSING_DB=

# Set to 1 to enable (needs `uv sync` first) — run: uv sync (required)
# HOUSING_HOMEHARVEST=

# Pushover app token (optional; enables push notifications) — https://pushover.net/apps/build (optional)
# PUSHOVER_TOKEN=

# Pushover user key (optional; enables push notifications) — https://pushover.net (optional)
# PUSHOVER_USER=

# RapidAPI key (X-RapidAPI-Key) — https://rapidapi.com/apimaker/api/zillow-com1 (required)
# RAPIDAPI_KEY=

# Reddit script-app client id — https://www.reddit.com/prefs/apps (required)
# REDDIT_CLIENT_ID=

# Reddit script-app secret — https://www.reddit.com/prefs/apps (required)
# REDDIT_CLIENT_SECRET=

# Comma-separated housing subreddits (optional)
# REDDIT_SUBS=

# Reddit username (used only to build a descriptive User-Agent) (optional)
# REDDIT_USERNAME=

# Redfin region id (SF = 17151) (optional)
# REDFIN_REGION_ID=

# RentCast API key (sent as X-Api-Key) — https://app.rentcast.io (required)
# RENTCAST_API_KEY=

# City to query (optional)
# RENTCAST_CITY=

# Search location (optional)
# ZILLOW_LOCATION=

# Max result pages to pull (~41/page) (optional)
# ZILLOW_MAX_PAGES=

# Zumper city slug (optional)
# ZUMPER_CITY=

