# Generated by `housing introspect --format env-example`. Copy to .env and fill in.
# The no-auth sources run on an empty .env; keys below only unlock extra sources/features.
# To share secrets with the team: fill .env, then `mise run secrets:encrypt` and commit .env.age
# (it's decrypted in memory at startup for anyone in .age.public-keys). See SETUP.md §Secrets.

# Max buildings to scrape detail for per run (optional)
# APARTMENTS_MAX_ITEMS=

# Max search-result pages to crawl for listing URLs (optional)
# APARTMENTS_MAX_PAGES=

# Default apartments.com search URL crawled by `ingest` (optional)
# APARTMENTS_SEARCH_URL=

# Apify API token — https://console.apify.com/account/integrations (required)
# APIFY_TOKEN=

# Default max listings per ingest run (1-360) (optional)
# CRAIGSLIST_MAX_LISTINGS=

# Restrict the ingest feed to today's posts: 1/true = on (default), 0/false = full backlog (optional)
# CRAIGSLIST_POSTED_TODAY=

# Default keyword filter for the standing `ingest` feed (blank = none) (optional)
# CRAIGSLIST_QUERY=

# Craigslist search category (apa = apartments/housing for rent) (optional)
# CRAIGSLIST_SEARCH_PATH=

# Whether `ingest` fetches per-listing detail for neighborhood/amenities (true/false) (optional)
# DAHLIA_ENRICH=

# Default max listings per run (optional)
# DAHLIA_LIMIT=

# Default portal feed for `ingest` (rental|ownership|all) (optional)
# DAHLIA_TYPE=

# Discord webhook URL (optional; posts a per-listing card to the shared channel, edited in place on change/removal) — https://support.discord.com/hc/en-us/articles/228383668-Intro-to-Webhooks (optional)
# DISCORD_WEBHOOK=

# Only notify for listings within this commute (minutes to HOUSING_ANCHOR; default 30) (optional)
# HOUSING_NOTIFY_MAX_MIN=
# Max new cards posted per run — the rest trickle to later runs (default 10) (optional)
# HOUSING_NOTIFY_MAX_PER_RUN=
# Spacing between Discord writes in ms, to respect the webhook rate limit (default 2000) (optional)
# HOUSING_NOTIFY_PACE_MS=

# Realtor.com listing type (for_rent | for_sale | sold | pending) (optional)
# HOMEHARVEST_LISTING_TYPE=

# Location to scrape (optional)
# HOMEHARVEST_LOCATION=

# Only listings from the last N days (optional)
# HOMEHARVEST_PAST_DAYS=

# Default 'lat,lon' anchor for --near (e.g. office location) (optional)
# HOUSING_ANCHOR=

# SQLite database path (optional)
# HOUSING_DB=

# Set to 1 to enable (needs `uv sync` first) — run: uv sync (required)
# HOUSING_HOMEHARVEST=

# RapidAPI key (X-RapidAPI-Key), subscribed to zillow-property-data1 — https://rapidapi.com/search/zillow-property-data1 (required)
# RAPIDAPI_KEY=

# Reddit script-app client id — https://www.reddit.com/prefs/apps (required)
# REDDIT_CLIENT_ID=

# Reddit script-app secret — https://www.reddit.com/prefs/apps (required)
# REDDIT_CLIENT_SECRET=

# Default max posts fetched per subreddit per run (optional)
# REDDIT_LIMIT=

# Default search query used by `ingest` (optional)
# REDDIT_QUERY=

# Comma-separated housing subreddits (optional)
# REDDIT_SUBS=

# Reddit username (used only to build a descriptive User-Agent) (optional)
# REDDIT_USERNAME=

# Default max listings per run (ingest) (optional)
# REDFIN_MAX_LISTINGS=

# Redfin region id (SF city = 17151) (optional)
# REDFIN_REGION_ID=

# Redfin region_type (6 = city) (optional)
# REDFIN_REGION_TYPE=

# RentCast API key (sent as X-Api-Key) — https://app.rentcast.io (required)
# RENTCAST_API_KEY=

# City to query (optional)
# RENTCAST_CITY=

# Max listings to fetch across pages (each 500 = one API request) (optional)
# RENTCAST_LIMIT=

# Two-letter state code to query (optional)
# RENTCAST_STATE=

# Listing status to query (Active | Inactive) (optional)
# RENTCAST_STATUS=

# Default city slug for `ingest` (empty = all cities in the portfolio) (optional)
# RENTSFNOW_CITY=

# Default page cap per run (12 units/page) (optional)
# RENTSFNOW_MAX_PAGES=

# Default max properties per run (optional)
# ZILLOW_MAX_ITEMS=

# Default free-text search used by `ingest` (when no --search/--zpids/etc. given) (optional)
# ZILLOW_SEARCH=

# Default listing type filter for `ingest` (all|sale|fsbo|rent|sold) (optional)
# ZILLOW_TYPE=

# Default Zumper city slug (optional)
# ZUMPER_CITY=

# Default max listings per run (paged, ~100/page) (optional)
# ZUMPER_MAX_ITEMS=

