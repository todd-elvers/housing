# Copy to .env (mise bootstrap does this automatically) and fill in what you have.
# Every value here is OPTIONAL — the five no-auth sources (craigslist, redfin,
# dahlia, zumper, rentsfnow) run with an empty .env. Keys only unlock extra sources.

# --- Storage ---
# SQLite file the engine reads/writes. Default: data/housing.db
# HOUSING_DB=data/housing.db

# --- Notifications (generic, optional) ---
# If set, a JSON summary of each run's new/changed/removed events is POSTed here.
# Leave unset to just record events in the DB + print a summary to stdout.
# HOUSING_WEBHOOK_URL=

# --- RentCast (Tier 1 — the legal aggregator spine) ---
# Self-serve key at https://app.rentcast.io  (free tier = 50 req/mo; Foundation $74/mo = 1000)
# RENTCAST_API_KEY=
# RENTCAST_CITY=San Francisco

# --- Reddit (Tier 1 — NEW-lead intel from housing subs) ---
# Create a "script" app at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=            # only used to build a descriptive User-Agent
# REDDIT_SUBS=sanfrancisco,bayarea,AskSF

# --- HomeHarvest / Realtor.com (Tier 1 — Python bridge via uv) ---
# Set to 1 to enable (requires `uv sync` to have installed homeharvest).
# HOUSING_HOMEHARVEST=0
# HOMEHARVEST_LOCATION=San Francisco, CA
# HOMEHARVEST_PAST_DAYS=3
