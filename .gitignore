# deps
node_modules/
.venv/

# local config / secrets — plaintext .env / .env.local stay local; the
# age-encrypted .env.age and the public .age.public-keys ARE committed.
.env
.env.local
!.env.age
!.age.public-keys

# data + state (keep static assets like commute-zones.geojson; ignore runtime files)
data/*.db
data/*.db-shm
data/*.db-wal
*.db
*.db-shm
*.db-wal

# misc
.DS_Store
*.log
scratch/
