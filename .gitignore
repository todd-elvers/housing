# deps
node_modules/
.venv/

# local config / secrets — plaintext .env / .env.local stay local; the
# age-encrypted .env.age and the public .age.public-keys ARE committed.
.env
.env.local
!.env.age
!.age.public-keys

# data + state (keep static assets like commute-zones.geojson; ignore runtime files)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.bak
data/*.bak-shm
data/*.bak-wal
data/house-hunt-seen.json
*.db
*.db-shm
*.db-wal

# personal / never-publish — the repo is public, so anything personal that
# lands in the working tree must be unstageable by a stray `git add .`
.claude/
*.jpeg
*.jpg
*.png
*.heic

# misc
.DS_Store
*.log
scratch/
