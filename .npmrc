# Supply-chain cooldown: only install package versions published >= 7 days ago.
# 10080 = 7 * 24 * 60 minutes. Units are MINUTES (aube default is 1440 = 24h).
# The floor is always enforced. Strict mode (fail vs. fall back to the newest
# >=7-day version when a range can't be satisfied) is left at its default (off)
# to keep adding dependencies frictionless; set minimumReleaseAgeStrict=true to enforce hard.
# NOTE: aube itself is a mise tool, not an npm dependency, so it is exempt from this.
minimumReleaseAge=10080
